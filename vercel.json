{
  "installCommand": "npm install",
  "builds": [
    {
      "src": "admin/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/admin$", "dest": "/admin/dist/index.html" },
    { "src": "/admin/(.*)", "dest": "/admin/dist/$1" },
    { "src": "/api/(.*)", "dest": "/api/$1" }
  ]
}
