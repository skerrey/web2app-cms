# Preview Mode (set to false to enable publishing)
# PREVIEW=true  - Changes save to browser only (demo/testing)
# PREVIEW=false - Enables publishing to GitHub (your own deployment)
PREVIEW=false

# GitHub Configuration (required when PREVIEW=false)
# Get your token from: https://github.com/settings/tokens
# Required scope: repo (full repository access)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Optional: Branch to commit to (defaults to 'main')
# GITHUB_BRANCH=main
